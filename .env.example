# Postgres connection string (Neon, Supabase, Vercel Postgres, or any Postgres).
# If your provider adds `?channel_binding=require` (Neon does), the app strips
# it automatically since it breaks postgres.js — no action needed either way.
DATABASE_URL=postgres://user:password@host/dbname

# Optional: canonical URL used in page metadata. Falls back to the Vercel
# deployment URL if unset.
NEXT_PUBLIC_SITE_URL=
